[Unit]
Description=Agent KAI daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# Adjust the repo path if you keep the checkout somewhere else.
WorkingDirectory=%h/kai-agent
ExecStart=%h/kai-agent/.venv/bin/python %h/kai-agent/main.py --daemon
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
