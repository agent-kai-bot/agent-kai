# Polygon Indexer Configuration
# Copy to .env and fill in values

# Postgres
POSTGRES_PASSWORD=change_me_in_production

# Alchemy fallback (for archive queries + degraded mode)
ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_API_KEY=YOUR_KEY

# Logging
LOG_LEVEL=INFO

# Ingest config
BACKFILL_DAYS=30
REORG_DEPTH=64

# Analytics worker intervals (seconds)
ANALYTICS_BALANCE_UPDATER_INTERVAL_SECONDS=2
ANALYTICS_OHLCV_BUILDER_INTERVAL_SECONDS=3
ANALYTICS_WHALE_DETECTOR_INTERVAL_SECONDS=5
ANALYTICS_HOLDER_SNAPSHOTS_INTERVAL_SECONDS=300

# Tracked tokens (comma-separated contract addresses)
# Add the tokens you want to index. Empty = index nothing until configured.
# Example: WMATIC,USDC,USDT,WETH,WBTC on Polygon
TRACKED_TOKENS=0x0d500B1d8E8eF31E21C99d1Db9A6444d3ADf1270,0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359,0xc2132D05D31c914a87C6611C10748AEb04B58e8F,0x7ceB23fD6bC0adD59E62ac25578270cFf1b9f619,0x1BFD67037B42Cf73acF2047067bd4F2C47D9BfD6
