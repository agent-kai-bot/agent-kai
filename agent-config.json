{
  "nats_url": "nats://localhost:4222",
  "default_agent": "kai",
  "workspaces_dir": "workspaces",
  "log_level": "DEBUG",
  "log_dir": "logs",

  "endpoints": {
    "kai-fast": {
      "provider": "openai",
      "base_url": "https://agent-k.ai/v1",
      "api_key_env": "AGENT_KAI_API_KEY",
      "api_key": "missing-kai-api-key",
      "models": {
        "kai-fast": {
          "context_window": 32000,
          "max_tokens": 2048,
          "temperature": 0.3,
          "top_p": 0.95
        }
      }
    },
    "kai-smart": {
      "provider": "openai",
      "base_url": "https://agent-k.ai/v1",
      "api_key_env": "AGENT_KAI_API_KEY",
      "api_key": "missing-kai-api-key",
      "models": {
        "kai-smart": {
          "context_window": 200000,
          "max_tokens": 4096,
          "temperature": 0.6,
          "top_p": 0.95
        }
      }
    },
    "kai-local": {
      "provider": "openai",
      "base_url": "http://192.168.222.45:8000/v1",
      "api_key": "not-needed",
      "models": {
        "qwen35-gptq": {
          "context_window": 32000,
          "max_tokens": 4096,
          "temperature": 0.6,
          "top_p": 0.95
        }
      }
    },
    "codex-cli": {
      "provider": "codex-cli",
      "base_url": "https://chatgpt.com/backend-api/codex",
      "default_model": "gpt-5.4",
      "models": {
        "gpt-5.4": {
          "context_window": 200000,
          "max_tokens": 16384,
          "reasoning_effort": "medium",
          "text_verbosity": "medium"
        },
        "gpt-5.3": {
          "context_window": 200000,
          "max_tokens": 16384,
          "reasoning_effort": "high",
          "text_verbosity": "medium"
        },
        "gpt-5.1-codex-mini": {
          "context_window": 128000,
          "max_tokens": 8192,
          "reasoning_effort": "medium",
          "text_verbosity": "low"
        }
      }
    },
    "openai-direct": {
      "provider": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "default_model": "gpt-5.4",
      "models": {
        "gpt-5.4": {
          "context_window": 200000,
          "max_tokens": 16384
        },
        "gpt-4o": {
          "context_window": 128000,
          "max_tokens": 4096
        },
        "spark": {
          "context_window": 128000,
          "max_tokens": 4096
        }
      }
    }
  },

  "agents": {
    "kai": {
      "description": "KAI — primary trading assistant, the user's main interface",
      "endpoint": "kai-smart",
      "fallback_endpoints": [
        {"endpoint": "kai-local", "model": "qwen35-gptq"},
        {"endpoint": "codex-cli", "model": "gpt-5.4"}
      ],
      "max_iterations": 2000
    },
    "ceo": {
      "description": "Strategic leader — sets vision, makes priority decisions, aligns all agents",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "ceo",
      "max_iterations": 2000
    },
    "cto": {
      "description": "Technical leader — architecture decisions, engineering standards, tech strategy",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "cto",
      "max_iterations": 2000
    },
    "architect": {
      "description": "System designer — blueprints, API contracts, data models, design docs",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "architect",
      "max_iterations": 2000
    },
    "developer": {
      "description": "Builder — writes, edits, debugs, and ships code",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "developer",
      "max_iterations": 200
    },
    "qa": {
      "description": "Quality gatekeeper — tests, bug reports, code review, coverage",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "qa",
      "max_iterations": 2000
    },
    "ux-manager": {
      "description": "UX champion — user flows, usability, accessibility, design system",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "ux-manager",
      "max_iterations": 2000
    },
    "project-manager": {
      "description": "Coordinator — task tracking, priorities, schedules, cross-agent communication",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "project-manager",
      "max_iterations": 2000
    },
    "seo": {
      "description": "Search optimizer — keywords, meta tags, technical SEO, content strategy",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "seo",
      "max_iterations": 2000
    },
    "sales-marketing": {
      "description": "Growth driver — messaging, copy, go-to-market, campaigns, lead gen",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "sales-marketing",
      "max_iterations": 2000
    },
    "trader": {
      "description": "Execution specialist — places trades, manages positions, order lifecycle",
      "endpoint": "kai-smart",
      "fallback_endpoints": [
        {"endpoint": "kai-local", "model": "qwen35-gptq"},
        {"endpoint": "codex-cli", "model": "gpt-5.4"}
      ],
      "workspace": "trader",
      "max_iterations": 200
    },
    "analyst": {
      "description": "Technical analysis — indicators, patterns, chart reading, trading signals",
      "endpoint": "kai-smart",
      "fallback_endpoints": [
        {"endpoint": "kai-local", "model": "qwen35-gptq"},
        {"endpoint": "codex-cli", "model": "gpt-5.4"}
      ],
      "workspace": "analyst",
      "max_iterations": 200
    },
    "risk-manager": {
      "description": "Capital guardian — position sizing, stop losses, exposure limits, drawdown monitoring",
      "endpoint": "kai-smart",
      "fallback_endpoints": [
        {"endpoint": "kai-local", "model": "qwen35-gptq"},
        {"endpoint": "codex-cli", "model": "gpt-5.4"}
      ],
      "workspace": "risk-manager",
      "max_iterations": 200
    },
    "scanner": {
      "description": "Market radar — pump.fun monitoring, new token alerts, breakout detection",
      "endpoint": "kai-fast",
      "fallback_endpoint": null,
      "workspace": "scanner",
      "max_iterations": 200
    },
    "onchain": {
      "description": "Blockchain investigator — wallet tracking, contract analysis, liquidity checks",
      "endpoint": "kai-smart",
      "fallback_endpoint": null,
      "workspace": "onchain",
      "max_iterations": 200
    },
    "mentor": {
      "description": "Reflection coach — reads other agents' sessions and authors reusable skills for them",
      "endpoint": "kai-smart",
      "fallback_endpoints": [
        {"endpoint": "codex-cli", "model": "gpt-5.4"},
        {"endpoint": "kai-local", "model": "qwen35-gptq"}
      ],
      "workspace": "mentor",
      "max_iterations": 200
    }
  },

  "memory": {
    "enabled": true,
    "user_profile_enabled": true,
    "memory_char_limit": 11000,
    "user_char_limit": 6875
  },

  "skills": {
    "enabled": true
  },

  "signal_handlers": [
    {
      "name": "any-buy-to-analyst",
      "enabled": false,
      "match": {
        "signal_type": "BUY"
      },
      "action": "dispatch_agent",
      "agent": "analyst",
      "task_template": "A {strategy} BUY signal just fired for {symbol} at ${price}. Run a multi-timeframe TA (1h + 4h + 1d) and tell me whether you'd validate this — what's your independent technical read? Be honest if it looks like noise.",
      "cooldown_seconds": 600
    },
    {
      "name": "any-sell-to-analyst",
      "enabled": false,
      "match": {
        "signal_type": "SELL"
      },
      "action": "dispatch_agent",
      "agent": "analyst",
      "task_template": "A {strategy} SELL signal just fired for {symbol} at ${price}. Run a multi-timeframe TA and tell me whether the trend break is real or this is a fakeout.",
      "cooldown_seconds": 600
    },
    {
      "name": "high-confidence-buy-to-risk-manager",
      "enabled": false,
      "match": {
        "signal_type": "BUY",
        "confidence": "high"
      },
      "action": "dispatch_agent",
      "agent": "risk-manager",
      "task_template": "A high-confidence BUY signal arrived for {symbol} at ${price} from {strategy}. Check current portfolio exposure via get_positions and size a position assuming 1.5% risk per trade and ATR-based stops. Tell me the recommended quantity, stop, and target.",
      "cooldown_seconds": 600
    },
    {
      "name": "auto-execute-clucmay-buy",
      "enabled": false,
      "match": {
        "strategy": "clucmay02",
        "signal_type": "BUY",
        "symbol": ["BTC", "ETH", "SOL"]
      },
      "action": "dispatch_agent",
      "agent": "trader",
      "task_template": "AUTOTRADE: a clucmay02 BUY signal fired for {symbol} at ${price}. Place a paper-trade BUY order using the place_order tool with a conservative size (start with 0.1 of the position the risk-manager would normally recommend). Use ATR-based stop and 2x take-profit. Confirm in your reply with the order details.",
      "cooldown_seconds": 1800,
      "requires_autotrade": true
    },
    {
      "name": "ai-token-analyzer-to-chat",
      "enabled": false,
      "match": {
        "source": "ai-token-analyzer"
      },
      "action": "chat_message",
      "template": "[bold magenta][ai-analyzer][/] {symbol} — see eval_results for the full report"
    }
  ],

  "tool_safety": {
    "shell_timeout_seconds": 30,
    "max_file_read_chars": 10000,
    "max_output_chars": 5000,

    "docker_sandbox": {
      "default_image": "python:3.12-slim",
      "default_timeout_seconds": 60,
      "max_timeout_seconds": 600,
      "default_network": "none",
      "allowed_networks": ["none", "bridge"],
      "memory_limit": "512m",
      "cpu_limit": "1.0",
      "pids_limit": 512,
      "tmpfs_size": "64m",
      "run_as_user": "65534:65534",
      "mount_workspace_by_default": true
    }
  }
}
